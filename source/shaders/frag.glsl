uint chrrom_r(uint addr) {
	return (chrrom[addr>>2] >> ((addr<<3)&31)) & 255;
}

layout(std430, binding=2) buffer State {
	uint scroll;
	uint ciram[0x200];
	uint oam[64];
	uint palram[8];
};

uint ciram_r(uint addr) {
	return (ciram[addr>>2] >> ((addr<<3)&31)) & 255;
}

uint oam_r(uint addr) {
	return (oam[addr>>2] >> ((addr<<3)&31)) & 255;
}

uint palram_r(uint addr) {
	return (palram[addr>>2] >> ((addr<<3)&31)) & 255;
}

void main() {
	uint py = uint(f_pos.y * 240);
	uint pxs = uint(f_pos.x * 256);
	uint pxg = (pxs + ((py<32)? 0 : scroll)) % 512;
	uint px = pxg % 256;
	
	uint nt = pxg/256;
	
	uint tx = (px/8);
	uint ty = (py/8);
	uint ti = tx + 32*ty;
	uint t = ciram_r(0x400*nt + ti);
	
	uint atei = (px/32) + 8*(py/32);
	uint ate = ciram_r(0x400*nt + 0x3c0 + atei);
	uint iate = (px/16%2) + 2*(py/16%2);
	uint attr = (ate >> (2*iate)) & 3;
	
	uint xt = px%8;
	uint yt = py%8;
	
	uint bp1 = chrrom_r(0x1000 + 16*t + yt);
	uint bp2 = chrrom_r(0x1000 + 16*t + yt + 8);
	uint ci =
		((bp1 >> (7-xt)) & 1) +
		2 * ((bp2 >> (7-xt)) & 1);
	
	uint c = palram_r(ci==0? 0 : 4*attr+ci);
	
	for (int i = 0; i < 64; i++) {
		uint spry = oam_r(4*i) + 1;
		uint t = oam_r(4*i + 1);
		uint attr = oam_r(4*i + 2);
		uint sprx = oam_r(4*i + 3);
		
		if (
			pxs < sprx || pxs >= sprx+8 ||
			py < spry || py >= spry+8 ||
			(ci != 0 && (attr & 32) != 0)
		) {
			continue;
		}
		
		uint xt = pxs-sprx;
		uint yt = py-spry;
		
		if ((attr & 64) != 0) { xt = 7-xt; }
		if ((attr & 128) != 0) { yt = 7-yt; }
		
		uint bp1 = chrrom_r(16*t + yt);
		uint bp2 = chrrom_r(16*t + yt + 8);
		uint ci =
			((bp1 >> (7-xt)) & 1) +
			2 * ((bp2 >> (7-xt)) & 1);
		
		if (ci != 0) {
			c = palram_r(16 + 4*(attr&3)+ci);
			break;
		}
	}
	
	
	o_col = global_palette[c%64];
}
